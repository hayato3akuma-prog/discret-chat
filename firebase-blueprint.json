        },
        "timestamp": {
          "type": "number"
        },
        "expiresAt": {
          "type": "number"
        },
        "readAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversationId",
        "fromId",
        "toId",
        "ciphertext",
        "iv",
        "signature",
        "timestamp",
        "expiresAt",
        "readAt",
        "createdAt"
      ]
    },
    "Group": {
      "title": "Group",
