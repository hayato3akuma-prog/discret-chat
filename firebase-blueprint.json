    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending friend request between two users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "fromId", "toId", "participantIds", "createdAtMs", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Confirmed bidirectional friendship created from an accepted friend request.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userA", "userB", "participantIds", "createdAtMs", "createdAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Directional user block record preventing DMs, friend requests, and group invites.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "blockerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "blockerId", "targetId", "participantIds", "createdAtMs", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Owner-only private encrypted key vault and DISCRET identity record."
    },
    "/users/{userId}/friendAliases/{targetUserId}": {
      "schema": { "$ref": "#/entities/FriendAlias" },
      "description": "Owner-only private friend/contact custom nicknames."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public E2EE profile (pseudonym, public keys, avatar, banner, bio) keyed by userId."
    },
    "/handleIndex/{handleKey}": {
      "schema": { "$ref": "#/entities/HandleIndex" },
      "description": "Exact normalized handle lookup pointing to userId."
    },
    "/pseudonyms/{pseudoKey}": {
      "schema": { "$ref": "#/entities/PseudonymClaim" },
      "description": "Global uniqueness reservation lock enforcing one unique pseudonym per user."
    },
    "/searchBuckets/{prefix}": {
      "schema": { "$ref": "#/entities/SearchBucket" },
      "description": "Prefix lookup buckets containing up to 12 userIds."
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct conversation documents between userA and userB."
    },
    "/conversations/{convId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "End-to-end encrypted direct message subcollection."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Encrypted group documents with bounded memberIds array."
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMemberEnvelope" },
      "description": "Wrapped group symmetric key envelopes per member."
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/GroupMessage" },
      "description": "End-to-end encrypted group message subcollection."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending friend requests keyed by fromId__toId."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Mutual friendships keyed by sorted userA__userB."
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "User blocks keyed by blockerId__targetId."
    }
  }
}
