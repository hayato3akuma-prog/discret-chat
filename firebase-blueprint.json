        },
        "bannerPreset": {
          "type": "string",
          "enum": ["none", "obsidian", "monolith", "eclipse", "emerald", "custom"]
        },
        "bannerDataUrl": {
          "type": "string",
          "maxLength": 380000
        },
        "accentTone": {
          "type": "string",
          "enum": ["platinum", "emerald", "slate", "amber", "crimson"]
        },
        "creatorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberIds": {
          "type": "array"
        },
        "lastMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageFromId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageCiphertext": {
          "type": "string",
          "maxLength": 320000
        },
        "lastMessageIv": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageSignature": {
          "type": "string",
