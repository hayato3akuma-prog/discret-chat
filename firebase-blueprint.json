    "GroupMemberEnvelope": {
      "title": "GroupMemberEnvelope",
      "description": "Wrapped AES-GCM group key envelope assigned to an individual group member.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "iv": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "wrappedKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "wrappedByUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "groupId", "iv", "wrappedKey", "wrappedByUserId", "createdAt"]
    },
    "GroupMessage": {
      "title": "GroupMessage",
      "description": "End-to-end encrypted group message envelope inside a group.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320000
        },
        "iv": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "timestamp": {
          "type": "number"
        },
