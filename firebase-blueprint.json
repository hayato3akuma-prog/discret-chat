        },
        "lastMessageTimestamp": {
          "type": "number"
        },
        "lastMessageExpiresAt": {
          "type": "number"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "avatarDataUrl",
        "bannerPreset",
        "bannerDataUrl",
        "accentTone",
        "creatorId",
        "memberIds",
        "lastMessageId",
        "lastMessageFromId",
        "lastMessageCiphertext",
        "lastMessageIv",
        "lastMessageSignature",
        "lastMessageTimestamp",
