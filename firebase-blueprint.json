{
  "entities": {
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private encrypted cryptographic vault and DISCRET account record bound to the authenticated owner UID.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "lookupId": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-f0-9]+$"
        },
        "encryptedVault": {
          "type": "string",
          "minLength": 16,
          "maxLength": 8192
        },
        "vaultSalt": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "vaultIv": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "fingerprint": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "ecdhPublicJwk": {
          "type": "object"
        },
        "ecdsaPublicJwk": {
          "type": "object"
        },
        "lastSeen": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "handle",
        "displayName",
        "lookupId",
        "encryptedVault",
        "vaultSalt",
        "vaultIv",
        "fingerprint",
        "ecdhPublicJwk",
        "ecdsaPublicJwk",
        "lastSeen",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public E2EE directory profile containing pseudonym, avatar/banner customization, and ECDH/ECDSA public keys (no PII).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "bio": {
          "type": "string",
          "maxLength": 80
        },
        "biography": {
          "type": "string",
          "maxLength": 400
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 300000
        },
        "avatarIcon": {
          "type": "string",
          "enum": ["initials", "shield", "moon", "compass", "eye", "feather", "diamond"]
        },
        "accentTone": {
          "type": "string",
          "enum": ["platinum", "emerald", "slate", "amber", "crimson"]
        },
        "bannerPreset": {
          "type": "string",
          "enum": ["none", "obsidian", "monolith", "eclipse", "emerald", "custom"]
        },
        "bannerDataUrl": {
          "type": "string",
          "maxLength": 380000
        },
        "bubbleShape": {
          "type": "string",
          "enum": ["rounded", "pill", "sharp", "editorial"]
        },
        "bubbleStyle": {
          "type": "string",
          "enum": ["glass", "solid", "outline", "elevated"]
        },
        "ecdhPublicJwk": {
          "type": "object"
        },
        "ecdsaPublicJwk": {
          "type": "object"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "handle",
        "displayName",
        "bio",
        "biography",
        "avatarDataUrl",
        "avatarIcon",
        "accentTone",
        "bannerPreset",
        "bannerDataUrl",
        "ecdhPublicJwk",
        "ecdsaPublicJwk",
        "fingerprint",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "HandleIndex": {
      "title": "HandleIndex",
      "description": "Normalized @handle lookup entry pointing to a public profile userId.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "handle", "createdAt"]
    },
    "PseudonymClaim": {
      "title": "PseudonymClaim",
      "description": "Global uniqueness reservation lock mapping normalized pseudonym keys to their owning userId.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "pseudoKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "pseudoKey", "createdAt", "updatedAt"]
    },
    "FriendAlias": {
      "title": "FriendAlias",
      "description": "Private user-scoped custom nickname assigned to a contact or friend.",
      "type": "object",
      "properties": {
        "targetUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["targetUserId", "nickname", "createdAt", "updatedAt"]
    },
    "SearchBucket": {
      "title": "SearchBucket",
      "description": "Bounded prefix bucket (up to 12 userIds) enabling handle/pseudonym lookup without blanket collection list queries.",
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "userIds": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["prefix", "userIds", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct encrypted conversation metadata and latest message preview envelope.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "lastMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageCiphertext": {
          "type": "string",
          "maxLength": 320000
        },
        "lastMessageIv": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageSignature": {
          "type": "string",
          "maxLength": 512
        },
        "lastMessageFromId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageToId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageTimestamp": {
          "type": "number"
        },
        "lastMessageExpiresAt": {
          "type": "number"
        },
        "lastMessageReadAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userA",
        "userB",
        "participantIds",
        "lastMessageId",
        "lastMessageCiphertext",
        "lastMessageIv",
        "lastMessageSignature",
        "lastMessageFromId",
        "lastMessageToId",
        "lastMessageTimestamp",
        "lastMessageExpiresAt",
        "lastMessageReadAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "DirectMessage": {
